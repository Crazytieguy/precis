{
  "enabledPlugins": {
    "autopilot@alignment-hive": true
  },
  "extraKnownMarketplaces": {
    "alignment-hive": {
      "source": {
        "source": "github",
        "repo": "Crazytieguy/alignment-hive"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(diff *)",
      "Bash(mkdir *)",
      "Bash(jq *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git add *)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(cargo t)",
      "Bash(cargo t *)",
      "Bash(cargo lint)",
      "Bash(cargo lint *)",
      "Bash(cargo fmt)",
      "Bash(cargo fmt *)",
      "Bash(cargo run --release *)",
      "Bash(cargo run --example clone_fixtures)",
      "Bash(cargo run --example clone_fixtures *)",
      "Bash(cargo run --example validate_ns *)",
      "Bash(cargo doc-md)",
      "Bash(cargo doc-md *)",
      "WebFetch",
      "WebSearch",
      "mcp__plugin_llms-fetch-mcp_llms-fetch"
    ],
    "ask": [
      "Bash(cargo publish)",
      "Bash(cargo publish *)",
      "Bash(git push)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(cargo test)",
      "Bash(cargo test *)",
      "Bash(cargo nextest)",
      "Bash(cargo nextest *)",
      "Bash(cargo clippy)",
      "Bash(cargo clippy *)",
      "Bash(cargo check)",
      "Bash(cargo check *)",
      "Bash(cargo build)",
      "Bash(cargo build *)",
      "Bash(cargo bench)",
      "Bash(cargo bench *)",
      "Bash(cargo insta)",
      "Bash(cargo insta *)",
      "Bash(rustc *)",
      "Bash(git -C *)"
    ]
  }
}

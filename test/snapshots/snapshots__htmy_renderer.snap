    29→def is_renderer(obj: Any | None) -> TypeGuard[RendererType]:
    30→    """Type guard that checks if the given object is a renderer."""
    31→    # Just a basic check, don't waste time here.
    32→    render: Any = getattr(obj, "render", None)
    33→    return render is not None

   205→async def _render_component(
   206→    component: Component,
   207→    *,
   208→    context: Context,
   209→    string_formatter: Callable[[str], str],
   210→) -> str:
   211→    """Renders the given component with the given settings."""
   212→    if hasattr(component, "htmy"):

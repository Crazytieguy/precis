    53→def is_streaming_renderer(obj: Any | None) -> TypeGuard[StreamingRendererType]:
    54→    """Type guard that checks if the given object is a streaming renderer."""
    55→    if not is_renderer(obj):
    56→        return False
    57→
    58→    # Just a basic check, don't waste time here.
    59→    stream: Any = getattr(obj, "stream", None)
    60→    return stream is not None

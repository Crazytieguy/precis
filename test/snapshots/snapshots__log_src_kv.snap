    98→        fn visit_pair(&mut self, key: Key<'kvs>, value: Value<'kvs>) -> Result<(), Error> {
    99→            if self.key == key {
   100→                self.found = Some(value);
   101→            }
   102→
   103→            Ok(())
   104→        }
   105→    }
   106→
   107→    let mut get = Get { key, found: None };
   108→

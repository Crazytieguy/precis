    11→func TestNew(t *testing.T) {
    12→	if os.Getenv("ANTHROPIC_API_KEY") == "" {
    13→		t.Skip("Skipping test: ANTHROPIC_API_KEY not set")
    14→	}
    15→
    16→	ctx := context.Background()
    17→
    18→	// Test default initialization
    19→	host, err := sdk.New(ctx, nil)
    20→	if err != nil {
    21→		t.Fatalf("Failed to create MCPHost with defaults: %v", err)
    22→	}
    23→	defer host.Close()
    24→
    25→	if host.GetModelString() == "" {
    26→		t.Error("Model string should not be empty")
    27→	}
    28→}
    30→func TestNewWithOptions(t *testing.T) {
    31→	if os.Getenv("ANTHROPIC_API_KEY") == "" {
    32→		t.Skip("Skipping test: ANTHROPIC_API_KEY not set")
    33→	}
    34→
    35→	ctx := context.Background()
    36→
    37→	opts := &sdk.Options{
    38→		Model:    "anthropic:claude-3-haiku-20240307",
    39→		MaxSteps: 5,
    40→		Quiet:    true,
    41→	}
    42→
    43→	host, err := sdk.New(ctx, opts)
    44→	if err != nil {
    45→		t.Fatalf("Failed to create MCPHost with options: %v", err)
    46→	}
    47→	defer host.Close()
    48→
    49→	if host.GetModelString() != opts.Model {
    50→		t.Errorf("Expected model %s, got %s", opts.Model, host.GetModelString())
    51→	}
    52→}
    54→func TestSessionManagement(t *testing.T) {
    55→	if os.Getenv("ANTHROPIC_API_KEY") == "" {
    56→		t.Skip("Skipping test: ANTHROPIC_API_KEY not set")
    57→	}
    58→
    59→	ctx := context.Background()
    60→
    61→	host, err := sdk.New(ctx, &sdk.Options{Quiet: true})
    62→	if err != nil {
    63→		t.Fatalf("Failed to create MCPHost: %v", err)
    64→	}
    65→	defer host.Close()
    66→
    67→	// Test clear session
    68→	host.ClearSession()
    69→	mgr := host.GetSessionManager()
    70→	if mgr.MessageCount() != 0 {
    71→		t.Error("Session should be empty after clear")
    72→	}
    73→
    74→	// Test save/load session (would need actual implementation)
    75→	tempFile := t.TempDir() + "/session.json"
    76→
    77→	// Add a message first
    78→	_, err = host.Prompt(ctx, "test message")
    79→	if err == nil { // Only if we have a working model
    80→		if err := host.SaveSession(tempFile); err != nil {
    81→			t.Errorf("Failed to save session: %v", err)
    82→		}
    83→
    84→		// Clear and reload
    85→		host.ClearSession()
    86→		if err := host.LoadSession(tempFile); err != nil {
    87→			t.Errorf("Failed to load session: %v", err)
    88→		}
    89→	}
    90→}


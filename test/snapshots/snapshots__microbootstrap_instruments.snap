    29→def make_path_with_query_string(scope: ScopeType) -> str:
    30→    path_with_query_string: typing.Final = urllib.parse.quote(scope["path"])
    31→    if scope["query_string"]:
    32→        return f"{path_with_query_string}?{scope['query_string'].decode('ascii')}"

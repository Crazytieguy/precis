    71→        event["extra"][SENTRY_EXTRA_OTEL_TRACE_URL_KEY] = trace_link_template.replace("{trace_id}", str(trace_id))
    72→    return event
    75→def wrap_before_send_callbacks(*callbacks: sentry_types.EventProcessor | None) -> sentry_types.EventProcessor:
    76→    def run_before_send(event: sentry_types.Event, hint: sentry_types.Hint) -> sentry_types.Event | None:
    77→        for callback in callbacks:
    78→            if not callback:
    79→                continue
    80→            temp_event = callback(event, hint)
    81→            if temp_event is None:
    82→                return None
    83→            event = temp_event
    84→        return event
    85→
    86→    return run_before_send

    39→    status_code: int,
    40→    start_time: int,
    41→) -> None:
    42→    process_time: typing.Final = time.perf_counter_ns() - start_time
    43→    url_with_query: typing.Final = make_path_with_query_string(typing.cast("ScopeType", request.scope))

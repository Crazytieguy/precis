     4→
     5→[project]
     6→name = "peepdb"
     7→version = "0.1.4"
     8→description = "CLI tool to view database tables fast"
     9→authors = [
    10→    {name = "Evangelos Meklis", email = "vmeklis@hotmail.com"},
    11→]
    12→readme = "README.md"
    13→requires-python = ">=3.9"

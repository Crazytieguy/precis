     7→impl Expand<'_> …
   284→fn expand_name(toasty: &TokenStream, name: &Name) -> TokenStream {
   285→    let parts = name.parts.iter().map(|part| {
   286→        let part = part.to_string();
   287→        quote! { #part.to_string() }
   288→    });
   289→
   290→    quote! {
   291→        #toasty::schema::Name {
   292→            parts: vec![#( #parts ),*],
   293→        }
   294→    }
   295→}


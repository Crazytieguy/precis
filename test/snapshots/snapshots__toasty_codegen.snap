     8→/// Creates a new identifier prefixed with `__toasty_` to avoid name collisions
     9→/// with user-defined types in generated code (e.g., generic type parameters).
    10→pub(crate) fn ident(name: &str) -> syn::Ident {
    11→    quote::format_ident!("__toasty_{name}")
    12→}


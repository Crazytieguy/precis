   207→fn rewrite_self(ty: &mut syn::Type, model: &syn::Ident) {
   208→    use syn::visit_mut::VisitMut;
   209→
   210→    struct RewriteSelf<'a>(&'a syn::Ident);
   211→
   212→    impl VisitMut for RewriteSelf<'_> {
   213→        fn visit_path_mut(&mut self, path: &mut syn::Path) {
   214→            syn::visit_mut::visit_path_mut(self, path);
   215→
   216→            if path.is_ident("Self") {
   217→                // print!("SELF; ident={:#?}", self.0);
   218→                path.segments[0].ident = self.0.clone();
   219→            }
   220→        }
   221→    }
   222→
   223→    RewriteSelf(model).visit_type_mut(ty);
   224→}


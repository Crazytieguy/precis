pyproject.toml
     1→[build-system]
     2→requires = ["flit_core>=3.12,<4"]
     3→build-backend = "flit_core.buildapi"
     4→
     5→[project]
     6→name = "tomli"
     7→version = "2.4.0"  # DO NOT EDIT THIS LINE MANUALLY. LET bump2version UTILITY DO IT
     8→description = "A lil' TOML parser"
     9→authors = [
    10→    { name = "Taneli Hukkinen", email = "hukkin@users.noreply.github.com" },
    11→]
    12→license = "MIT"
    13→license-files = ["LICENSE"]
    14→requires-python = ">=3.8"
    15→readme = "README.md"
    16→classifiers = [
    17→    "Operating System :: MacOS",
    18→    "Operating System :: Microsoft :: Windows",
    19→    "Operating System :: POSIX :: Linux",
    20→    "Programming Language :: Python :: 3 :: Only",
    21→    "Programming Language :: Python :: Implementation :: CPython",
    22→    "Programming Language :: Python :: Implementation :: PyPy",
    23→    "Topic :: Software Development :: Libraries :: Python Modules",
    24→    "Typing :: Typed",
    25→]
    26→keywords = ["toml"]
    27→
    28→[project.urls]
    29→"Homepage" = "https://github.com/hukkin/tomli"
    30→"Changelog" = "https://github.com/hukkin/tomli/blob/master/CHANGELOG.md"
    31→
    32→
    33→[tool.isort]
    34→# Force imports to be sorted by module, independent of import type
    35→force_sort_within_sections = true
    36→# Group first party and local folder imports together
    37→no_lines_before = ["LOCALFOLDER"]
    38→
    39→# Configure isort to work without access to site-packages
    40→known_first_party = ["tomli", "tests"]
    41→
    42→# Settings for Black compatibility
    43→profile = "black"
    44→
    45→
    46→[tool.tox]
    47→requires = ["tox>=4.21.1"]
    48→# Only run unittest envs when no args given to tox
    49→env_list = ["3.8", "3.9", "3.10", "3.11", "3.12", "3.13", "3.14"]
    50→
    51→[tool.tox.env_run_base]
    52→description = "run tests against a built package under {base_python}"
    53→pass_env = ["TOMLI_USE_MYPYC"]
    54→commands = [
    55→    ["python", "-m", "unittest", { replace = "posargs", extend = true }],
    56→]
    57→
    58→[tool.tox.env."profile"]
   129→[tool.coverage.run]
   130→branch = true
   131→source = ['tomli']
   132→
   133→[tool.coverage.report]
   134→# Regexes for lines to exclude from consideration
   135→exclude_lines = [
   136→    # Re-enable the standard pragma (with extra strictness)
   137→    '# pragma: no cover\b',
   138→    # Code for static type checkers
   139→    'if TYPE_CHECKING:',
   140→    # Scripts
   141→    'if __name__ == .__main__.:',
   142→]
   143→
   144→
   145→[tool.mypy]
   146→show_error_codes = true
   147→warn_unreachable = true
   148→strict = true
   149→strict_bytes = true
   150→local_partial_types = true
   151→# Disabling incremental mode is required for `warn_unused_configs = true`
   152→# (implied by `strict = true`) to work
   153→incremental = false
   154→
   155→enable_error_code = ["ignore-without-code"]
   156→
   157→[[tool.mypy.overrides]]
   167→[[tool.mypy.overrides]]
   168→# This matches `fuzzer/fuzz.py`.
   169→module = "fuzz"
   170→ignore_errors = true


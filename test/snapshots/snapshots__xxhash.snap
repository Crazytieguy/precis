    40→		"TestDigest",
    41→	} {
    42→		f, err := plug.Lookup(test)
    43→		if err != nil {
    44→			t.Fatalf("cannot find func %s: %s", test, err)
    45→		}
    46→		f.(func(*testing.T))(t)
    47→	}
    48→}


    7→readme = "README.md"
    8→repository = "https://github.com/rust-lang/log"
    9→documentation = "https://docs.rs/log"
    10→description = """
    11→A lightweight logging facade for Rust
    12→"""
    13→categories = ["development-tools::debugging"]
    14→keywords = ["logging"]
    15→exclude = ["rfcs/**/*"]
    16→rust-version = "1.68.0"
    17→edition = "2021"
    22→[features]
    23→max_level_off   = []
    24→max_level_error = []
    25→max_level_warn  = []
    26→max_level_info  = []
    27→max_level_debug = []
    28→max_level_trace = []
    30→release_max_level_off   = []
    31→release_max_level_error = []
    32→release_max_level_warn  = []
    33→release_max_level_info  = []
    34→release_max_level_debug = []
    35→release_max_level_trace = []
    37→std = []
    39→kv = []
    40→kv_sval = ["kv", "value-bag/sval", "sval", "sval_ref"]
    41→kv_std = ["std", "kv", "value-bag/error"]
    42→kv_serde = ["kv_std", "value-bag/serde", "serde"]
    44→# This is here to not break backwards compatibility with the implicit feature
    45→# that enables support for serde based on the dependency name. Since we're now
    46→# using serde_core, the implicit feature was renamed, this adds back an alias.
    47→serde = ["serde_core"]
    49→# Deprecated: use `kv_*` instead
    50→# These `*_unstable` features will be removed in a future release
    51→kv_unstable = ["kv", "value-bag"]
    52→kv_unstable_sval = ["kv_sval", "kv_unstable"]
    53→kv_unstable_std = ["kv_std", "kv_unstable"]
    54→kv_unstable_serde = ["kv_serde", "kv_unstable_std"]
    56→[dependencies]
    57→serde_core = { version = "1.0", optional = true, default-features = false }
    58→sval = { version = "2.16", optional = true, default-features = false }
    59→sval_ref = { version = "2.16", optional = true, default-features = false }
    60→value-bag = { version = "1.12", optional = true, default-features = false, features = ["inline-i128"] }
    62→[dev-dependencies]
    63→serde = { version = "1.0", features = ["derive"] }
    64→serde_json = { version = "1.0" }
    65→serde_test = { version = "1.0" }
    66→sval = { version = "2.16" }
    67→sval_derive = { version = "2.16" }
    68→value-bag = { version = "1.12", features = ["test"] }
    70→# NOTE: log doesn't actually depend on this crate. However, our dependencies,
    71→# serde and sval, dependent on version 1.0 of the crate, which has problem fixed
    72→# in 1.0.60, specifically in the following commit
    73→# https://github.com/dtolnay/proc-macro2/commit/e31d61910049e097afdd3d27c37786309082bdcb.
    74→# By defining the crate as direct dependency we can increase its minimal
    75→# version making the minimal (crate) version CI happy.
    76→proc-macro2 = { version = "1.0.63", default-features = false }

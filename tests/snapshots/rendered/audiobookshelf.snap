    13→const options = commandLineArgs(optionDefinitions)
    21→const isDev = process.env.NODE_ENV !== 'production'
    38→const inputConfig = options.config ? Path.resolve(options.config) : null
    39→const inputMetadata = options.metadata ? Path.resolve(options.metadata) : null
    41→const PORT = options.port || process.env.PORT || 3333
    42→const HOST = options.host || process.env.HOST
    43→const CONFIG_PATH = inputConfig || process.env.CONFIG_PATH || Path.resolve('config')
    44→const METADATA_PATH = inputMetadata || process.env.METADATA_PATH || Path.resolve('metadata')
    45→const SOURCE = options.source || process.env.SOURCE || 'debian'
    47→const ROUTER_BASE_PATH = process.env.ROUTER_BASE_PATH ?? '/audiobookshelf'
    52→const Server = new server(SOURCE, PORT, HOST, CONFIG_PATH, METADATA_PATH, ROUTER_BASE_PATH)

    2→  "name": "audiobookshelf",
    3→  "version": "2.34.0",
    5→  "description": "Self-hosted audiobook and podcast server",
    6→  "main": "index.js",
    7→  "scripts": {
    8→    "dev": "nodemon --watch server index.js -- --dev",
    9→    "start": "node index.js",
    10→    "start-dev": "node index.js --prod-with-dev-env",
    11→    "client": "cd client && npm ci && npm run generate",
    12→    "prod": "npm run client && npm ci && node index.js",
    13→    "build-win": "npm run client && pkg -t node20-win-x64 -o ./dist/win/audiobookshelf -C GZip .",
    14→    "build-win-no-compress": "npm run client && pkg -t node20-win-x64 -o ./dist/win/audiobookshelf .",
    15→    "build-linux": "build/linuxpackager",
    16→    "docker": "docker buildx build --platform linux/amd64,linux/arm64 --push .  -t advplyr/audiobookshelf",
    17→    "docker-amd64-local": "docker buildx build --platform linux/amd64 --load .  -t advplyr/audiobookshelf-amd64-local",
    18→    "docker-arm64-local": "docker buildx build --platform linux/arm64 --load .  -t advplyr/audiobookshelf-arm64-local",
    19→    "deploy-linux": "node deploy/linux",
    20→    "test": "mocha",
    21→    "coverage": "nyc mocha"
    22→  },
    23→  "bin": "index.js",

                5→const ALPHA = 'abcdefghijklmnopqrstuvwxyz';
                7→const DIGIT = '0123456789';
                9→const ALPHABET = {
                10→  DIGIT,
                11→  ALPHA,
                12→  ALPHA_DIGIT: ALPHA + ALPHA.toUpperCase() + DIGIT,
                13→};
                15→const generateString = (size = 16, alphabet = ALPHABET.ALPHA_DIGIT) => {
                16→  let str = '';
                17→  const { length } = alphabet;
                18→  const randomValues = new Uint32Array(size);
                19→  crypto.randomFillSync(randomValues);
                20→  for (let i = 0; i < size; i++) {
                21→    str += alphabet[randomValues[i] % length];
                22→  }
                24→  return str;
                27→export default {
                28→  isNode: true,
                29→  classes: {
                30→    URLSearchParams,
                31→    FormData,
                32→    Blob: (typeof Blob !== 'undefined' && Blob) || null,
                33→  },
                34→  ALPHABET,
                35→  generateString,
                36→  protocols: ['http', 'https', 'file', 'data'],
                37→};

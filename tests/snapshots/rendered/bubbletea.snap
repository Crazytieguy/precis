    139→	ForegroundColor color.Color
    141→	// WindowTitle sets the terminal window title. Support depends on the
    142→	// terminal.
    143→	WindowTitle string
    145→	// ProgressBar when not nil, shows a progress bar in the terminal's
    146→	// progress bar section. Support depends on the terminal.
    147→	ProgressBar *ProgressBar
    172→	// DisableBracketedPasteMode disables bracketed paste mode for this view.

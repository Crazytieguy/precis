    164→// Global variable can be initialized either by a constant expression
    165→// or a pointer to another global variable. This struct represents the
    166→// latter.
    167→typedef struct Relocation Relocation;
    168→struct Relocation {
    169→  Relocation *next;
    170→  int offset;
    171→  char **label;
    172→  long addend;
    173→};
    175→// AST node

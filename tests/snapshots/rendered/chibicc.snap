    …
    225→} NodeKind;
    227→// AST node type
    228→struct Node {
    229→  NodeKind kind; // Node kind
    230→  Node *next;    // Next node
    231→  Type *ty;      // Type, e.g. int or pointer to int
    232→  Token *tok;    // Representative token
    234→  Node *lhs;     // Left-hand side
    235→  Node *rhs;     // Right-hand side
    237→  // "if" or "for" statement
    238→  Node *cond;
    239→  Node *then;
    240→  Node *els;
    241→  Node *init;
    242→  Node *inc;
    244→  // "break" and "continue" labels
    245→  char *brk_label;
    246→  char *cont_label;
    248→  // Block or statement expression
    249→  Node *body;
    251→  // Struct member access
    252→  Member *member;
    254→  // Function call
    255→  Type *func_ty;
    256→  Node *args;
    257→  bool pass_by_stack;
    258→  Obj *ret_buffer;
    260→  // Goto or labeled statement, or labels-as-values
    261→  char *label;
    262→  char *unique_label;
    263→  Node *goto_next;
    265→  // Switch
    266→  Node *case_next;
    267→  Node *default_case;
    269→  // Case
    270→  long begin;
    271→  long end;
    273→  // "asm" string literal
    274→  char *asm_str;
    276→  // Atomic compare-and-swap
    277→  Node *cas_addr;
    278→  Node *cas_old;
    279→  Node *cas_new;
    281→  // Atomic op= operators
    282→  Obj *atomic_addr;
    283→  Node *atomic_expr;
    285→  // Variable
    286→  Obj *var;
    288→  // Numeric literal
    289→  int64_t val;
    290→  long double fval;
    291→};

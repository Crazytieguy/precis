                    335→      stream.graph,
                    336→      new DifferenceStreamWriter<KeyValue<K, V>>(),
                    337→    )
                    338→    const operator = new OutputElectricMessagesOperator<K, V>(
                    339→      stream.graph.getNextOperatorId(),
                    340→      stream.connectReader() as DifferenceStreamReader<KeyValue<K, V>>,
                    341→      output.writer,
                    342→      fn,
                    343→      stream.graph.frontier(),
                    344→    )
                    345→    stream.graph.addOperator(operator)
                    346→    stream.graph.addStream(output.connectReader())
                    347→    return output
                    348→  }

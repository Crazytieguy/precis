                    324→/**
                    325→ * Outputs the messages from the stream in ElectricSQL format
                    326→ * @param fn - The function to call with a batch of messages
                    327→ */
                    328→export function outputElectricMessages<
                    329→  K extends T extends KeyValue<infer K extends string, infer _V> ? K : never,
                    330→  V extends T extends KeyValue<K, infer V> ? V : never,
                    331→  T,
                    332→>(fn: (data: ChangeMessage<Row<V>>[]) => void) {
                    333→  return (stream: IStreamBuilder<T>): IStreamBuilder<KeyValue<K, V>> => {
                    334→    const output = new StreamBuilder<KeyValue<K, V>>(
                    335→      stream.graph,
                    336→      new DifferenceStreamWriter<KeyValue<K, V>>(),
                    337→    )
                    338→    const operator = new OutputElectricMessagesOperator<K, V>(
                    339→      stream.graph.getNextOperatorId(),
                    340→      stream.connectReader() as DifferenceStreamReader<KeyValue<K, V>>,
                    341→      output.writer,
                    342→      fn,
                    343→      stream.graph.frontier(),
                    344→    )
                    345→    stream.graph.addOperator(operator)
                    346→    stream.graph.addStream(output.connectReader())
                    347→    return output
                    348→  }

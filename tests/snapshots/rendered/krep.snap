    47→/* --- Match tracking structure --- */
    48→// Define match_position_t BEFORE match_result_t
    49→typedef struct
    50→{
    51→   size_t start_offset; // Starting position of the match
    52→   size_t end_offset;   // Ending position of the match (exclusive)
    53→} match_position_t;
    55→typedef struct match_result_t // Add the struct tag here
    56→{
    57→   match_position_t *positions; // Dynamically resizing array of match positions
    58→   uint64_t count;              // Number of matches found and stored
    59→   uint64_t capacity;           // Current allocated capacity of the positions array
    60→} match_result_t;               // Typedef remains the same
    65→typedef struct search_params
    …
    96→/* --- Function Pointer Type for Search Algorithms --- */
    97→// Returns count (lines or matches depending on mode). result can be NULL unless track_positions is true.
    98→typedef uint64_t (*search_func_t)(const search_params_t *params,
    99→                                  const char *text_start,
    100→                                  size_t text_len,
    101→                                  match_result_t *result);
    103→// Data passed to each search thread
    104→typedef struct
    105→{
    106→   int thread_id;
    107→   const search_params_t *params; // Pointer to shared search parameters
    108→   const char *chunk_start;       // Pointer to the start of the memory chunk for this thread
    109→   size_t chunk_len;              // Length of the chunk to process (may include overlap)
    110→   search_func_t search_algo;     // Pre-selected search algorithm for this chunk
    112→   // Thread-specific results
    113→   match_result_t *local_result; // For position tracking (default/-o)
    114→   uint64_t count_result;        // For line counting (-c) or match counting (-co)
    116→   // Status flags
    117→   bool error_flag; // Flag to indicate an error occurred in the thread
    119→   // Padding to prevent false sharing (ensure struct size is multiple of 64 bytes)
    120→   // Current size approx 56 bytes. Adding sufficient padding.
    121→   char padding[64]; 
    122→} thread_data_t;
    124→/* --- Thread Pool Implementation --- */
    125→typedef struct task
    126→{
    127→   void *(*func)(void *); // Task function
    128→   void *arg;             // Function argument
    129→   struct task *next;     // Next task in queue
    130→} task_t;
    132→typedef struct
    133→{
    134→   pthread_t *threads;           // Array of worker threads
    135→   int num_threads;              // Number of worker threads
    136→   task_t *task_queue;           // Task queue head
    137→   task_t *task_queue_tail;      // Task queue tail for faster enqueue
    138→   pthread_mutex_t queue_mutex;  // Mutex for task queue access
    139→   pthread_cond_t queue_cond;    // Condition variable for task availability
    140→   pthread_cond_t complete_cond; // Condition variable for task completion
    141→   size_t working_threads;       // Counter for busy threads
    142→   atomic_bool shutdown;         // Shutdown flag
    143→} thread_pool_t;
    145→/* --- Thread Pool API --- */
    146→thread_pool_t *thread_pool_init(int num_threads);
    147→bool thread_pool_submit(thread_pool_t *pool, void *(*func)(void *), void *arg);
    148→void thread_pool_wait_all(thread_pool_t *pool);
    149→void thread_pool_destroy(thread_pool_t *pool);

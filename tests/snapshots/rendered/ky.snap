           3→import {Ky} from './core/Ky.js';
           4→import {requestMethods, stop, retry} from './core/constants.js';
           5→import type {KyInstance} from './types/ky.js';
           6→import type {Input, Options} from './types/options.js';
           7→import {validateAndMerge} from './utils/merge.js';
           8→import {type Mutable} from './utils/types.js';
          10→const createInstance = (defaults?: Partial<Options>): KyInstance => {
          11→	// eslint-disable-next-line @typescript-eslint/promise-function-async
          12→	const ky: Partial<Mutable<KyInstance>> = (input: Input, options?: Options) => Ky.create(input, validateAndMerge(defaults, options));
          13→
          14→	for (const method of requestMethods) {
          15→		// eslint-disable-next-line @typescript-eslint/promise-function-async
          16→		ky[method] = (input: Input, options?: Options) => Ky.create(input, validateAndMerge(defaults, options, {method}));
          17→	}
          18→
          19→	ky.create = (newDefaults?: Partial<Options>) => createInstance(validateAndMerge(newDefaults));
          20→	ky.extend = (newDefaults?: Partial<Options> | ((parentDefaults: Partial<Options>) => Partial<Options>)) => {
          21→		if (typeof newDefaults === 'function') {
          22→			newDefaults = newDefaults(defaults ?? {});
          23→		}
          24→
          25→		return createInstance(validateAndMerge(defaults, newDefaults));
          26→	};
          27→
          28→	ky.stop = stop;
          29→	ky.retry = retry;
          30→
          31→	return ky as KyInstance;
        …
          36→export default ky;

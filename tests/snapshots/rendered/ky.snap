        HTTPError.ts
            5→export class HTTPError<T = unknown> extends Error {
            6→	public response: KyResponse<T>;
            7→	public request: KyRequest;
            8→	public options: NormalizedOptions;
            10→	constructor(response: Response, request: Request, options: NormalizedOptions) {
            11→		const code = (response.status || response.status === 0) ? response.status : '';
            12→		const title = response.statusText ?? '';
            13→		const status = `${code} ${title}`.trim();
            14→		const reason = status ? `status code ${status}` : 'an unknown error';
            16→		super(`Request failed with ${reason}: ${request.method} ${request.url}`);
            18→		this.name = 'HTTPError';
            19→		this.response = response;
            20→		this.request = request;
            21→		this.options = options;

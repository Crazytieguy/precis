    1→package lo
    3→// Partial returns new function that, when called, has its first argument set to the provided value.
    4→// Play: https://go.dev/play/p/Sy1gAQiQZ3v
    5→func Partial[T1, T2, R any](f func(a T1, b T2) R, arg1 T1) func(T2) R {
    6→	return func(t2 T2) R {
    7→		return f(arg1, t2)
    8→	}
    11→// Partial1 returns new function that, when called, has its first argument set to the provided value.
    12→// Play: https://go.dev/play/p/D-ASTXCLBzw
    13→func Partial1[T1, T2, R any](f func(T1, T2) R, arg1 T1) func(T2) R {
    14→	return Partial(f, arg1)
    17→// Partial2 returns new function that, when called, has its first argument set to the provided value.
    18→// Play: https://go.dev/play/p/-xiPjy4JChJ
    19→func Partial2[T1, T2, T3, R any](f func(T1, T2, T3) R, arg1 T1) func(T2, T3) R {
    20→	return func(t2 T2, t3 T3) R {
    21→		return f(arg1, t2, t3)
    22→	}
    25→// Partial3 returns new function that, when called, has its first argument set to the provided value.

    72→func Find[T any](collection []T, predicate func(item T) bool) (T, bool) {
    73→	for i := range collection {
    74→		if predicate(collection[i]) {
    75→			return collection[i], true
    76→		}
    77→	}
    79→	var result T
    80→	return result, false

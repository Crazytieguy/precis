                    28→/// Prints a "backtrace" of some `Error`.
                    29→pub fn log_backtrace(e: &Error) {
                    30→    let mut message = format!("{e}");
                    32→    for cause in e.chain().skip(1) {
                    33→        write!(message, "\n\tCaused by: {cause}").unwrap();
                    34→    }
                    36→    error!("{message}");

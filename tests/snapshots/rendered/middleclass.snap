    151→    subclass = function(self, name)
    152→      assert(type(self) == 'table', "Make sure that you are using 'Class:subclass' instead of 'Class.subclass'")
    153→      assert(type(name) == "string", "You must provide a name(string) for your class")
    155→      local subclass = _createClass(name, self)
    157→      for methodName, f in pairs(self.__instanceDict) do
    158→        if not (methodName == "__index" and type(f) == "table") then
    159→          _propagateInstanceMethod(subclass, methodName, f)
    160→        end
    161→      end
    162→      subclass.initialize = function(instance, ...) return self.initialize(instance, ...) end
    164→      self.subclasses[subclass] = true
    165→      self:subclassed(subclass)
    167→      return subclass

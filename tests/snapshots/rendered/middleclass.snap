    31→local function _createIndexWrapper(aClass, f)
    32→  if f == nil then
    33→    return aClass.__instanceDict
    34→  elseif type(f) == "function" then
    35→    return function(self, name)
    36→      local value = aClass.__instanceDict[name]
    38→      if value ~= nil then
    39→        return value
    40→      else
    41→        return (f(self, name))
    42→      end
    43→    end
    44→  else -- if  type(f) == "table" then
    45→    return function(self, name)
    46→      local value = aClass.__instanceDict[name]
    48→      if value ~= nil then
    49→        return value
    50→      else
    51→        return f[name]
    52→      end
    53→    end
    54→  end
    …
    57→local function _propagateInstanceMethod(aClass, name, f)
    58→  f = name == "__index" and _createIndexWrapper(aClass, f) or f
    59→  aClass.__instanceDict[name] = f
    61→  for subclass in pairs(aClass.subclasses) do
    62→    if rawget(subclass.__declaredMethods, name) == nil then
    63→      _propagateInstanceMethod(subclass, name, f)
    64→    end
    65→  end
    …
    68→local function _declareInstanceMethod(aClass, name, f)
    69→  aClass.__declaredMethods[name] = f
    71→  if f == nil and aClass.super then
    72→    f = aClass.super.__instanceDict[name]
    73→  end
    75→  _propagateInstanceMethod(aClass, name, f)
    …
    78→local function _tostring(self) return "class " .. self.name end
    79→local function _call(self, ...) return self:new(...) end
    81→local function _createClass(name, super)
    …
    109→local function _includeMixin(aClass, mixin)
    110→  assert(type(mixin) == 'table', "mixin must be a table")
    112→  for name,method in pairs(mixin) do
    113→    if name ~= "included" and name ~= "static" then aClass[name] = method end
    114→  end
    116→  for name,method in pairs(mixin.static or {}) do
    117→    aClass.static[name] = method
    118→  end
    120→  if type(mixin.included)=="function" then mixin:included(aClass) end
    121→  return aClass
    …
    125→  __tostring   = function(self) return "instance of " .. tostring(self.class) end,
    127→  initialize   = function(self, ...) end,
    129→  isInstanceOf = function(self, aClass)
    130→    return type(aClass) == 'table'
    131→       and type(self) == 'table'
    132→       and (self.class == aClass
    133→            or type(self.class) == 'table'
    134→            and type(self.class.isSubclassOf) == 'function'
    135→            and self.class:isSubclassOf(aClass))

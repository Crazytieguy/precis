    78→local function _tostring(self) return "class " .. self.name end
    79→local function _call(self, ...) return self:new(...) end
    …
    81→local function _createClass(name, super)
    …
    83→  dict.__index = dict
    85→  local aClass = { name = name, super = super, static = {},
    86→                   __instanceDict = dict, __declaredMethods = {},
    87→                   subclasses = setmetatable({}, {__mode='k'})  }
    89→  if super then
    90→    setmetatable(aClass.static, {
    91→      __index = function(_,k)
    92→        local result = rawget(dict,k)
    93→        if result == nil then
    94→          return super.static[k]
    95→        end
    96→        return result
    97→      end
    98→    })
    99→  else
    100→    setmetatable(aClass.static, { __index = function(_,k) return rawget(dict,k) end })
    101→  end
    103→  setmetatable(aClass, { __index = aClass.static, __tostring = _tostring,
    104→                         __call = _call, __newindex = _declareInstanceMethod })
    109→local function _includeMixin(aClass, mixin)
    …
    112→  for name,method in pairs(mixin) do
    113→    if name ~= "included" and name ~= "static" then aClass[name] = method end
    114→  end
    116→  for name,method in pairs(mixin.static or {}) do
    117→    aClass.static[name] = method
    118→  end
    120→  if type(mixin.included)=="function" then mixin:included(aClass) end

    139→    allocate = function(self)
    140→      assert(type(self) == 'table', "Make sure that you are using 'Class:allocate' instead of 'Class.allocate'")
    141→      return setmetatable({ class = self }, self.__instanceDict)
    …
    144→    new = function(self, ...)
    145→      assert(type(self) == 'table', "Make sure that you are using 'Class:new' instead of 'Class.new'")
    146→      local instance = self:allocate()

    345→func storeEnabled(name string) bool {
    346→	stores := os.Getenv("TRUST_STORES")
    347→	if stores == "" {
    348→		return true
    349→	}
    350→	for _, store := range strings.Split(stores, ",") {
    351→		if store == name {
    352→			return true
    353→		}
    354→	}
    355→	return false
    358→func fatalIfErr(err error, msg string) {
    359→	if err != nil {
    360→		log.Fatalf("ERROR: %s: %s", msg, err)
    361→	}
    364→func fatalIfCmdErr(err error, cmd string, out []byte) {
    365→	if err != nil {
    366→		log.Fatalf("ERROR: failed to execute \"%s\": %s\n\n%s\n", cmd, err, out)
    367→	}
    370→func pathExists(path string) bool {
    371→	_, err := os.Stat(path)
    372→	return err == nil
    375→func binaryExists(name string) bool {
    376→	_, err := exec.LookPath(name)
    377→	return err == nil

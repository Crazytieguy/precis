            7→class LineWriter {
            8→	private lines: string[] = [];
            9→	private indentLevel: number = 0;
            10→	private indentStr: string = '    '; // 4 spaces
            15→	writeLine(line: string = ''): void {
            16→		if (line.trim() === '') {
            17→			this.lines.push('');
            18→		} else {
            19→			this.lines.push(this.indentStr.repeat(this.indentLevel) + line);
            20→		}
            26→	write(text: string): void {
            27→		if (this.lines.length === 0) {
            28→			this.lines.push('');
            29→		}
            30→		const lastIndex = this.lines.length - 1;
            31→		if (this.lines[lastIndex] === '') {
            32→			this.lines[lastIndex] = this.indentStr.repeat(this.indentLevel) + text;
            33→		} else {
            34→			this.lines[lastIndex] += text;
            35→		}
            41→	indent(): void {
            42→		this.indentLevel++;
            48→	outdent(): void {
            49→		if (this.indentLevel > 0) {
            50→			this.indentLevel--;
            51→		}
            57→	toString(): string {
            58→		return this.lines.join('\n');
            64→	clear(): void {
            65→		this.lines = [];
            66→		this.indentLevel = 0;

    src/
        index.ts
            159→class MonacoEditorWebpackPlugin implements webpack.WebpackPluginInstance {
            160→	private readonly options: IInternalMonacoEditorWebpackPluginOpts;
            162→	constructor(options: MonacoEditorWebpackPlugin.IMonacoEditorWebpackPluginOpts = {}) {
            163→		const monacoEditorPath = options.monacoEditorPath;
            164→		const metadata = getEditorMetadata(monacoEditorPath);
            165→		const languages = resolveDesiredLanguages(metadata, options.languages, options.customLanguages);
            166→		const features = resolveDesiredFeatures(metadata, options.features);
            167→		this.options = {
            168→			languages,
            169→			features,
            170→			filename: options.filename || '[name].worker.js',
            171→			monacoEditorPath,
            172→			publicPath: options.publicPath || '',
            173→			globalAPI: options.globalAPI || false
            174→		};
            177→	apply(compiler: webpack.Compiler): void {
            178→		const { languages, features, filename, monacoEditorPath, publicPath, globalAPI } = this.options;
            179→		const compilationPublicPath = getCompilationPublicPath(compiler);
            180→		const modules = [EDITOR_MODULE].concat(languages).concat(features);
            181→		const workers: ILabeledWorkerDefinition[] = [];
            182→		modules.forEach((module) => {
            183→			if (module.worker) {
            184→				workers.push({
            185→					label: module.label,
            186→					id: module.worker.id,
            187→					entry: module.worker.entry
            188→				});
            189→			}
            190→		});
            191→		const rules = createLoaderRules(
            192→			languages,
            193→			features,
            194→			workers,
            195→			filename,
            196→			monacoEditorPath,
            197→			publicPath,
            198→			compilationPublicPath,
            199→			globalAPI
            200→		);
            201→		const plugins = createPlugins(compiler, workers, filename, monacoEditorPath);
            202→		addCompilerRules(compiler, rules);
            203→		addCompilerPlugins(compiler, plugins);

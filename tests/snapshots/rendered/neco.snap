    86→/// @defgroup Generators Generators
    87→/// A generator is a specialized iterator-bound coroutine that can produce a
    88→/// sequence of values to be iterated over.
    89→/// @{
    90→typedef struct neco_gen neco_gen;
    91→
    92→int neco_gen_start(neco_gen **gen, size_t data_size, void(*coroutine)(int argc, void *argv[]), int argc, ...);
    93→int neco_gen_startv(neco_gen **gen, size_t data_size, void(*coroutine)(int argc, void *argv[]), int argc, void *argv[]);
    94→int neco_gen_retain(neco_gen *gen);
    95→int neco_gen_release(neco_gen *gen);
    96→int neco_gen_yield(void *data);
    97→int neco_gen_yield_dl(void *data, int64_t deadline);
    98→int neco_gen_next(neco_gen *gen, void *data);
    99→int neco_gen_next_dl(neco_gen *gen, void *data, int64_t deadline);
    100→int neco_gen_close(neco_gen *gen);

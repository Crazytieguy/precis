    30→/// @defgroup BasicOperations Basic operations
    31→/// Neco provides standard operations for starting a coroutine, sleeping, 
    32→/// suspending, resuming, yielding to another coroutine, joining/waiting for
    33→/// child coroutines, and exiting a running coroutine.
    34→/// @{
    35→int neco_start(void(*coroutine)(int argc, void *argv[]), int argc, ...);
    36→int neco_startv(void(*coroutine)(int argc, void *argv[]), int argc, void *argv[]);
    37→int neco_yield(void);
    38→int neco_sleep(int64_t nanosecs);
    39→int neco_sleep_dl(int64_t deadline);
    40→int neco_join(int64_t id);
    41→int neco_join_dl(int64_t id, int64_t deadline);
    42→int neco_suspend(void);
    43→int neco_suspend_dl(int64_t deadline);
    44→int neco_resume(int64_t id);
    45→void neco_exit(void);
    46→int64_t neco_getid(void);
    47→int64_t neco_lastid(void);
    48→int64_t neco_starterid(void);

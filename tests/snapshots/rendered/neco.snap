    55→/// @defgroup Channels Channels
    56→/// Channels allow for sending and receiving values between coroutines.
    57→/// By default, sends and receives will block until the other side is ready.
    58→/// This allows the coroutines to synchronize without using locks or condition
    59→/// variables.
    60→/// @{
    61→typedef struct neco_chan neco_chan;
    62→
    63→int neco_chan_make(neco_chan **chan, size_t data_size, size_t capacity);
    64→int neco_chan_retain(neco_chan *chan);
    65→int neco_chan_release(neco_chan *chan);
    66→int neco_chan_send(neco_chan *chan, void *data);
    67→int neco_chan_send_dl(neco_chan *chan, void *data, int64_t deadline);
    68→int neco_chan_broadcast(neco_chan *chan, void *data);
    69→int neco_chan_recv(neco_chan *chan, void *data);
    70→int neco_chan_recv_dl(neco_chan *chan, void *data, int64_t deadline);
    71→int neco_chan_tryrecv(neco_chan *chan, void *data);
    72→int neco_chan_close(neco_chan *chan);
    73→int neco_chan_select(int nchans, ...);
    74→int neco_chan_select_dl(int64_t deadline, int nchans, ...);
    75→int neco_chan_selectv(int nchans, neco_chan *chans[]);
    76→int neco_chan_selectv_dl(int nchans, neco_chan *chans[], int64_t deadline);
    77→int neco_chan_tryselect(int nchans, ...);
    78→int neco_chan_tryselectv(int nchans, neco_chan *chans[]);
    79→int neco_chan_case(neco_chan *chan, void *data);

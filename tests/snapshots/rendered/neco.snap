        27→// Causes the calling coroutine to relinquish the CPU.
        28→// This operation should be called from a coroutine, otherwise it does nothing.
        29→void sco_yield(void);
        …
        31→// Get the identifier for the current coroutine.
        32→// This operation should be called from a coroutine, otherwise it returns zero.
        33→int64_t sco_id(void);
        …
        35→// Pause the current coroutine.
        36→// This operation should be called from a coroutine, otherwise it does nothing.
        37→void sco_pause(void);
        …
        39→// Resume a paused coroutine.
        40→// If the id is invalid or does not belong to a paused coroutine then this
        41→// operation does nothing.
        42→// Calling sco_resume(0) is a special case that continues a runloop. See the
        43→// README for an example.
        44→void sco_resume(int64_t id);
        …
        46→// Returns true if there are any coroutines running, yielding, or paused.
        47→bool sco_active(void);
        …
        55→void sco_detach(int64_t id);
        …
        57→// Attach a coroutine to a thread.
        58→// This allows for moving coroutines between threads.
        59→// If the id is invalid or does not belong to a detached coroutine then this
        60→// operation does nothing.
        61→// Once attached, the coroutine will be paused.
        62→void sco_attach(int64_t id);
        …
        64→// Exit a coroutine early.
        65→// This _will not_ exit the program. Rather, it's for ending the current 
        66→// coroutine and quickly switching to the thread's runloop before any other
        67→// scheduled (yielded) coroutines run.
        68→// This operation should be called from a coroutine, otherwise it does nothing.
        69→void sco_exit(void);
        …
        71→// Returns the user data of the currently running coroutine.
        72→void *sco_udata(void);
        …

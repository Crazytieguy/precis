    107→/// @defgroup Mutexes Mutexes
    108→/// A mutex is synchronization mechanism that blocks access to variables by
    109→/// multiple coroutines at once. This enforces exclusive access by a coroutine
    110→/// to a variable or set of variables and helps to avoid data inconsistencies
    111→/// due to race conditions.
    112→/// @{
    113→typedef struct { int64_t _0; intptr_t _1[5]; } neco_mutex;
    114→
    115→#define NECO_MUTEX_INITIALIZER { 0 }
    116→
    117→int neco_mutex_init(neco_mutex *mutex);
    118→int neco_mutex_lock(neco_mutex *mutex);
    119→int neco_mutex_lock_dl(neco_mutex *mutex, int64_t deadline);
    120→int neco_mutex_trylock(neco_mutex *mutex);

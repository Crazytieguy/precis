            28→    // TODO: check out json-seq as specified in RFC7464 (https://datatracker.ietf.org/doc/html/rfc7464)?
            29→    // basically jsonl but every json object is prefixed with 0x1e
            30→    Jsonl,
            32→    #[clap(skip)]
            33→    Any,
            34→}
            36→pub trait Parser {
            37→    fn extension(&self) -> &'static str;
            39→    fn allow_array_root(&self) -> bool;
            41→    fn parse(&self, data: &str) -> Result<Value>;
            43→    fn syntax_highlight(&self, name: &str, value: &Value) -> Vec<SyntaxToken>;
            45→    fn parse_root(&self, validator: Option<&dyn Parser>, data: &[u8]) -> Result<Value> {
            46→        let data = String::from_utf8(data.to_vec()).context("parse content utf8")?;
            47→        let value = self.parse(&data)?;
            49→        match value {
            50→            Value::Object(_) => {}
            51→            Value::Array(_) => {
            52→                let allow =
            53→                    validator.map_or_else(|| self.allow_array_root(), Parser::allow_array_root);
            54→                if !allow {
            55→                    let schema = validator.map_or_else(|| self.extension(), Parser::extension);
            56→                    bail!("schema '{schema}' does not allow array as root");
            57→                }
            58→            }
            59→            _ => bail!("root value must be either object or array"),
            60→        }
            62→        Ok(value)
            63→    }
            64→}

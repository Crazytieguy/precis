            32→#[derive(Parser, Debug)]
            35→pub struct CliArgs {
            36→    #[arg(short, long, action = ArgAction::Count, global = true)]
            37→    pub verbose: u8,
            39→    #[command(subcommand)]
            40→    pub command: Command,
            41→}
            43→#[derive(Subcommand, Debug)]
            44→pub enum Command {
            45→    Init(InitArgs),
            46→    Search(Search),
            47→    List(List),
            48→    Info(Info),
            49→    Update(Update),
            50→    Install(InstallArgs),

        main.rs
            57→async fn main() -> spResult<()> {
            58→    let cli_args = CliArgs::parse();
            60→    if let Command::Init(ref init_args_ref) = cli_args.command {
            61→        match run_init_command(init_args_ref, cli_args.verbose).await {
            62→            Ok(_) => {
            63→                return Ok(());
            64→            }
            65→            Err(e) => {
            66→                eprintln!("{}: Init command failed: {:#}", "Error".red().bold(), e);
            67→                process::exit(1);
            68→            }
            69→        }
            70→    }
            72→    let config = Config::load().map_err(|e| {
            73→        SpsError::Config(format!(
            74→            "Could not load config (have you run 'sps init'?): {e}"
            75→        ))
            76→    })?;
            78→    let level_filter = match cli_args.verbose {
            79→        0 => LevelFilter::INFO,
            80→        1 => LevelFilter::DEBUG,
            81→        _ => LevelFilter::TRACE,
            82→    };
            83→    let max_log_level = level_filter.into_level().unwrap_or(tracing::Level::INFO);
            85→    let env_filter = EnvFilter::builder()
            86→        .with_default_directive(level_filter.into())
            87→        .with_env_var("SPS_LOG")
            88→        .from_env_lossy();
            90→    let log_dir = config.logs_dir();
            135→    let cache = Arc::new(Cache::new(&config).map_err(|e| {
            136→        SpsError::Cache(format!(
            137→            "Could not initialize cache (ensure 'sps init' was successful): {e}"
            138→        ))
            139→    })?);
            141→    let needs_update_check = matches!(
            142→        cli_args.command,
            143→        Command::Install(_) | Command::Search { .. } | Command::Info { .. } | Command::Upgrade(_)
            144→    );
            146→    if needs_update_check {
            147→        if let Err(e) = check_and_run_auto_update(&config, Arc::clone(&cache)).await {
            148→            error!("Error during auto-update check: {}", e); // Use `error!` macro
            149→        }
            150→    } else {
            151→        debug!(
            152→            // Use `debug!` macro
            153→            "Skipping auto-update check for command: {:?}",
            154→            cli_args.command
            155→        );
            156→    }
            158→    // Pass config and cache to the command's run method
            159→    let command_execution_result = match &cli_args.command {
            160→        Command::Init(_) => {
            161→            /* This case is handled above and main exits */
            162→            unreachable!()
            163→        }
            164→        _ => cli_args.command.run(&config, cache).await,
            165→    };
            167→    if let Err(e) = command_execution_result {
            168→        // For pipeline commands (Install, Reinstall, Upgrade), errors are already
            169→        // displayed via the status system, so only log in verbose mode
            170→        let is_pipeline_command = matches!(
            171→            cli_args.command,
            172→            Command::Install(_) | Command::Reinstall(_) | Command::Upgrade(_)
            173→        );
            175→        if is_pipeline_command {
            176→            // Only show error details in verbose mode
            177→            if cli_args.verbose > 0 {
            178→                error!("Command failed: {:#}", e);
            179→                eprintln!("{}: {:#}", "Error".red().bold(), e);
            180→            }
            181→        } else {
            182→            // For non-pipeline commands, show errors normally
            183→            error!("Command failed: {:#}", e);
            184→            eprintln!("{}: {:#}", "Error".red().bold(), e);
            185→        }
            186→        process::exit(1);
            187→    }
            189→    debug!("Command completed successfully."); // Use `debug!` macro
            190→    Ok(())

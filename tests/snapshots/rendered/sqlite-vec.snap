        extra_init.py
            1→from typing import List
            2→from struct import pack
            3→from sqlite3 import Connection
            6→def serialize_float32(vector: List[float]) -> bytes:
            7→    """Serializes a list of floats into the "raw bytes" format sqlite-vec expects"""
            8→    return pack("%sf" % len(vector), *vector)
            11→def serialize_int8(vector: List[int]) -> bytes:
            12→    """Serializes a list of integers into the "raw bytes" format sqlite-vec expects"""
            13→    return pack("%sb" % len(vector), *vector)

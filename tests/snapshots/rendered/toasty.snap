                4→use proc_macro2::TokenStream;
                6→pub fn generate_model(input: TokenStream) -> syn::Result<TokenStream> {
                7→    let item: syn::ItemStruct = syn::parse2(input)?;
                8→    let model = schema::Model::from_ast(&item, false)?;
                10→    Ok(expand::root_model(&model))
                13→pub fn generate_embed(input: TokenStream) -> syn::Result<TokenStream> {
                14→    let item: syn::ItemStruct = syn::parse2(input)?;
                15→    let model = schema::Model::from_ast(&item, true)?;
                17→    Ok(expand::embedded_model(&model))

     129→[tool.coverage.run]
     130→branch = true
     131→source = ['tomli']
     132→
     133→[tool.coverage.report]
     134→# Regexes for lines to exclude from consideration
     135→exclude_lines = [
     136→    # Re-enable the standard pragma (with extra strictness)
     137→    '# pragma: no cover\b',
     138→    # Code for static type checkers
     139→    'if TYPE_CHECKING:',
     140→    # Scripts
     141→    'if __name__ == .__main__.:',
     142→]
     145→[tool.mypy]
     146→show_error_codes = true
     147→warn_unreachable = true
     148→strict = true
     149→strict_bytes = true
     150→local_partial_types = true
     151→# Disabling incremental mode is required for `warn_unused_configs = true`
     152→# (implied by `strict = true`) to work
     153→incremental = false
     154→
     155→enable_error_code = ["ignore-without-code"]
     156→
     157→[[tool.mypy.overrides]]
     158→module = "tests.*"
     159→disallow_untyped_defs = false
     160→
     161→[[tool.mypy.overrides]]
     162→# This matches `benchmark/run.py`. Since benchmark/ is
     163→# not a package, we use the module name here.
     164→module = "run"
     165→ignore_errors = true
     166→
     167→[[tool.mypy.overrides]]
     168→# This matches `fuzzer/fuzz.py`.
     169→module = "fuzz"
     170→ignore_errors = true

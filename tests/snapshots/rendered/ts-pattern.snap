        32→export function isMatching<const p extends Pattern<unknown>>(
        33→  pattern: p
        34→): (value: unknown) => value is P.infer<p>;
        48→export function isMatching<const T, const P extends PatternConstraint<T>>(
        49→  pattern: P,
        50→  value: T
        51→): value is T & WithDefault<P.narrow<T, P>, P.infer<P>>;
        53→export function isMatching<const p extends Pattern<any>>(
        54→  ...args: [pattern: p, value?: any]
        55→): boolean | ((vale: any) => boolean) {
        56→  if (args.length === 1) {
        57→    const [pattern] = args;
        58→    return (value: any): value is MatchedValue<any, P.infer<p>> =>
        59→      matchPattern(pattern, value, () => {});
        60→  }
        61→  if (args.length === 2) {
        62→    const [pattern, value] = args;
        63→    return matchPattern(pattern, value, () => {});
        64→  }
        66→  throw new Error(
        67→    `isMatching wasn't given the right number of arguments: expected 1 or 2, received ${args.length}.`
        68→  );

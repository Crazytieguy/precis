            174→export type ArrayToVariadicUnion<input, excluded> = MaybeAddReadonly<
            175→  | (input extends readonly [any, ...any] | readonly [...any, any] ? never : [])
            176→  | (excluded extends readonly [...any, any]
            177→      ? [...Extract<input, readonly any[]>, ValueOf<input>]
            178→      : [ValueOf<input>, ...Extract<input, readonly any[]>]),
            179→  IsReadonlyArray<input>
            180→>;
            183→export type Distribute<unions extends readonly any[]> =
            184→  unions extends readonly [
            185→    { cases: infer cases; path: infer path },
            186→    ...infer tail
            187→  ]
            188→    ? cases extends { value: infer value; subUnions: infer subUnions }
            189→      ? [
            190→          [value, path],
            191→          ...Distribute<Extract<subUnions, readonly any[]>>,
            192→          ...Distribute<tail>
            193→        ]
            194→      : never
            195→    : [];

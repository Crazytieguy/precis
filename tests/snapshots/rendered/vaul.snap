         803→export const Overlay = React.forwardRef<HTMLDivElement, React.ComponentPropsWithoutRef<typeof DialogPrimitive.Overlay>>(
         804→  function ({ ...rest }, ref) {
         805→    const { overlayRef, snapPoints, onRelease, shouldFade, isOpen, modal, shouldAnimate } = useDrawerContext();
         806→    const composedRef = useComposedRefs(ref, overlayRef);
         807→    const hasSnapPoints = snapPoints && snapPoints.length > 0;
         808→    const onMouseUp = React.useCallback((event: React.PointerEvent<HTMLDivElement>) => onRelease(event), [onRelease]);
         809→
         810→    // Overlay is the component that is locking scroll, removing it will unlock the scroll without having to dig into Radix's Dialog library
         811→    if (!modal) {
         812→      return null;
         813→    }
         814→
         815→    return (
         816→      <DialogPrimitive.Overlay
         817→        onMouseUp={onMouseUp}
         818→        ref={composedRef}
         819→        data-vaul-overlay=""
         820→        data-vaul-snap-points={isOpen && hasSnapPoints ? 'true' : 'false'}
         821→        data-vaul-snap-points-overlay={isOpen && shouldFade ? 'true' : 'false'}
         822→        data-vaul-animate={shouldAnimate?.current ? 'true' : 'false'}
         823→        {...rest}
         824→      />
         825→    );

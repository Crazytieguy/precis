          27→export interface WithFadeFromProps {
          28→  /**
          29→   * Array of numbers from 0 to 100 that corresponds to % of the screen a given snap point should take up.
          30→   * Should go from least visible. Example `[0.2, 0.5, 0.8]`.
          31→   * You can also use px values, which doesn't take screen height into account.
          32→   */
          33→  snapPoints: (number | string)[];
          34→  /**

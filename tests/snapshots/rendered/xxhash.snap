     112→// Sum appends the current hash to b and returns the resulting slice.
     113→func (d *Digest) Sum(b []byte) []byte {
     114→	s := d.Sum64()
     115→	return append(
     116→		b,
     117→		byte(s>>56),
     118→		byte(s>>48),
     119→		byte(s>>40),
     120→		byte(s>>32),
     121→		byte(s>>24),
     122→		byte(s>>16),
     123→		byte(s>>8),
     124→		byte(s),
     125→	)

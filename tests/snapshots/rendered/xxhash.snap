       1→// Package xxhash implements the 64-bit variant of xxHash (XXH64) as described
       2→// at https://xxhash.com/.
       3→package xxhash
       4→
       5→import (
       6→	"encoding/binary"
       7→	"errors"
       8→	"math/bits"

    19→--- A token with its kind and source span.
    20→--- @class Token
    21→--- @field kind string
    22→--- @field span table
    23→local Token = {}
    24→Token.__index = Token
    26→function Token:new(kind, span)
    27→    return setmetatable({ kind = kind, span = span }, self)
    28→end
    30→--- Get the display string for this token.
    31→function Token:display()
    32→    return string.format("%s:%d-%d", self.kind, self.span[1], self.span[2])
    33→end
    35→--- Create a parser for the given source text.
    36→function M.new_parser(source)
    37→    return {
    38→        source = source,
    39→        tokens = {},
    40→        parse = function(self)
    41→            return self.tokens
    42→        end,
    43→    }
    44→end
    46→M.MAX_TOKENS = 1024
    48→M.VERSION = "0.1.0"

     2→local M = {}
     4→--- Process items and return the total count.
     5→--- @param items table List of items to process.
     6→--- @return number count The total count.
     7→function M.process(items)
     8→    local count = 0
     9→    for _, item in ipairs(items) do
    10→        count = count + 1
    11→    end
    12→    return count
    13→end
